# ── NICU Care Backend Environment Variables ──────────────────────────
# All variables are optional for local testing; sensible fallbacks are active.

# 1. Google AI Studio (Gemini 2.5 Flash for grounded clinical generation)
# Obtain free API key at: https://aistudio.google.com/
# GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google Maps Platform (Google Places API for live hospital lookup)
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 3. TypeSafe AI (Native Jev System One decision engine - requires Python >= 3.10)
# TYPESAFE_API_KEY=your_typesafe_api_key_here

# 4. Local Ollama Service (bge-m3 embeddings, llama3.1:8b, etc.)
# OLLAMA_URL=http://127.0.0.1:11434

# 5. Cloud Feature Flags (set to true when deploying to GCP)
USE_CLOUD_FIRESTORE=false
USE_CLOUD_SPEECH=false
USE_REDIS_CACHE=false
